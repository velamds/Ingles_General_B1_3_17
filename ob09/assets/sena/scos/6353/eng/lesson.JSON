text"}], "correct": 1}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": " \nWhat does the fortune teller say? \n", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "post_instructions", "contents": [{"content": "\nInstructions: Complete the following steps. Fill in the Self-Assessment.\n", "type": "text"}]}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}], "type": "DWS", "template_override": 1}], "stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "template_override": 1, "id": 0}, {"id": 1, "title": "", "contents": [{"value": {"images": [{"text": "", "id": 0, "time": "0", "image": "engenn8le17ob09re2img05.jpg"}, {"text": "Jerry from New York wants to know, \"why is a broken mirror seven years bad luck?\" <br/><br/>\nI actually know this one. This superstition was created by the Romans who believed that life was supposed to renew again every seven years. Damaging a mirror was viewed the same as damaging one's health. It was thought that this curse could only be corrected in the next seven year cycle.", "id": 1, "time": "100", "image": "engenn8le17ob09re2img05.jpg"}, {"text": "This sounds like it would turn into a great excuse not to do anything. <br/><br/>I imagine, these things were said in ancient Rome before the \u201cbroken mirror bad luck\u201d curse:<br/>\n\u201cif I ate less, I would lose more weight\u201d or \u201cif I were younger, I would fight that gladiator.\u201d<br/>\nOr finally, \u201cI would conquer Mongolia if I liked the cold.\u201d and your friends would all laugh at you.\n<br/><br/>\nHowever, with the broken mirror excuse all you have to say is, \u201cI broke a mirror last night, so I guess I can't make the next invasion of Germany. Sorry.\u201d", "id": 2, "time": "21000", "image": "engenn8le17ob09re2img02.jpg"}, {"text": "Fortunately, with many superstitions, there are some antidotes to counter it. Here are a few:<br/><br/>If you break a mirror you are supposed to throw salt over your shoulder. <br/>\nIf you break a mirror you are supposed to immediately spin around three times in a counterclockwise direction.  Finally, you should take a piece of the broken mirror and touch a tombstone with it. It is believed that this will lift the curse immediately.\n<br/><br/>\nOr, if you find yourself with a broken mirror,\nbuy another mirror.", "id": 3, "time": "49800", "image": "engenn8le17ob09re2img01.jpg"}], "audiosrc": "engenn8le17ob09re2aud01", "coverimg": "engenn8le17ob09re2img05.jpg"}, "type": "slideshow"}], "_data": [], "type": "audio", "template_override": 1}]}]}