ontent": "because it is a difficult position to be in.", "type": "text"}], "selected": 0}, {"id": 3, "text": "", "correct": true, "_data": [{"content": " If I had to go to jail I would be sad for many reasons.", "type": "text"}], "selected": 0}, {"id": 4, "text": "", "correct": true, "_data": [{"content": "I think my mother would be very upset and I think she would get sick.", "type": "text"}], "selected": 0}, {"id": 5, "text": "", "correct": false, "_data": [{"content": " <br/>I couldn't believe the story because my friend said the man was a good person.", "type": "text"}], "selected": 0}, {"id": 6, "text": "", "correct": 0, "_data": [{"content": " I would like to meet him and help him.", "type": "text"}], "selected": 0}, {"id": 7, "text": "", "correct": true, "_data": [{"content": "If I could go to visit him I would bring food, books and things to help him spend his free time.", "type": "text"}], "selected": 0}], "id": 0, "_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}, {"content": "secondary_7", "type": "objective"}]}], "stimuli_ids": [], "id": 8, "template_override": 1}, {"_data": [{"type": "instructions", "contents": [{"content": " \nI feel good! \n", "type": "text"}]}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "post_instructions", "contents": [{"content": "Instructions: Move the sentences up or down <span class=\"sena-icon sena-icon-vertical-drag\"></span> to put them in the correct order. \n", "type": "text"}]}], "type": "MT1", "questions": [{"responses": [{"id": 0, "correct": 0, "_data": [{"content": "", "type": "text"}], "selected": 0}, {"id": 1, "correct": 1, "_data": [{"content": "I love getting up early. ", "type": "text"}], "selected": 0}], "id": 0, "_data": [{"type": "question", "contents": [{"content": "One of my favorite activities in the morning is to run.", "type": "text"}]}, {"content": "secondary_8", "type": "objective"}]}, {"responses": [{"id": 0, "correct": 0, "_data": [{"content": "", "type": "text"}], "selected": 0}, {"id": 1, "correct": 1, "_data": [{"content": "She just started to feel good with the new location.  ", "type": "text"}], "selected": 0}], "id": 1, "_data": [{"type": "question", "contents": [{"content": "Camilla works in a big company but now she has to go to a different branch.", "type": "text"}]}, {"content": "secondary_8", "type": "objective"}]}, {"responses": [{"id": 0, "correct": 0, "_data": [{"content": "", "type": "text"}], "selected": 0}, {"id": 1, "correct": 1, "_data": [{"content": "She decided to study harder.   ", "type": "text"}], "selected": 0}], "id": 2, "_data": [{"type": "question", "contents": [{"content": "Sam is getting bad grades in university.", "type": "text"}]}, {"content": "secondary_8", "type": "objective"}]}, {"responses": [{"id": 0, "correct": 0, "_data": [{"content": "", "type": "text"}], "selected": 0}, {"id": 1, "correct": 1, "_data": [{"content": "I enjoy spending time with them.", "type": "text"}], "selected": 0}], "id": 3, "_data": [{"type": "question", "contents": [{"content": "On Sundays I go to different places with my family.", "type": "text"}]}, {"content": "secondary_8", "type": "objective"}]}], "stimuli_ids": [], "id": 9, "template_override": 1}, {"_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}], "type": "RSLT", "questions": [{"responses": [{"id": 0, "correct": 0, "_data": [{"content": "", "type": "text"}], "selected": 0}, {"id": 1, "correct": 1, "_data": [{"content": "", "type": "text"}], "selected": 0}], "id": 0, "_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}]}], "stimuli_ids": [], "id": 10, "template_override": 1}, {"_data": [{"type": "instructions", "contents": [{"content": " \nWhat happened at the party in Valhalla?\n", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "\nInstructions: Complete the following steps. Fill in the Self Assessment.\n", "type": "text"}]}], "type": "DWS", "questions": [{"responses": [{"id": 0, "correct": 1, "_data": [{"content": "", "type": "text"}], "selected": 0}], "id": 0, "_data": [{"type": "question", "contents": [{"content": "engenn8le17ob01re7pdf01.pdf", "type": "pdf"}]}]}], "stimuli_ids": [], "id": 11, "template_override": 1}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "stimuli": [{"id": 0, "template_override": 1, "type": "welcome", "_data": [], "contents": [{}]}, {"_data": [], "type": "audio", "id": 1, "template_override": 1, "title": "", "contents": [{"value": {"images": [{"text": "", "image": "engenn8le17ob01re2img05.jpg", "time": "0", "id": 0}, {"text": "Halloween is fast approaching once again and to honor this amazing time of year, some of my readers suggested writing about superstitions. I am also going to try to answer my readers emails about superstitions, so everyone send in your questions. Now, researching superstitions is something I love to do and one of the most popular comments is, why is the number 13  bad luck?", "image": "engenn8le17ob01re2img05.jpg", "time": "100", "id": 1}, {"text": "Now, if I were a more talented writer, I would go into more detail about this topic, but there are too many different theories as to why 13 is bad luck, so I decided to just talk about the thirteenth guest at the table. <br/><br/>There are two ancient events in which a 13th guest attends a dinner celebration and bad things start happening for the other twelve guests.", "image": "engenn8le17ob01re2img05.jpg", "time": "24000", "id": 2}, {"text": "The first one to discuss comes from the Bible where Judas, the 13th apostle to arrive at the last supper, later betrays Jesus.\n<br/>\nNorse mythology and a dinner party in Vahalla. Loki, the God of mischief, is believed to have introduced  evil into the world after crashing a party attended by twelve other gods\n<br/><br/>\nNow, if Judas came to my party, I would make him eat outside and if Loki knocked on my door, I wouldn't answer. Even today, guests who arrive late at my dinner party risk being turned away. Unless of course, they're cute.", "image": "engenn8le17ob01re2img02.jpg", "time": "46000", "id": 3}], "coverimg": "engenn8le17ob01re2img05.jpg", "audiosrc": "engenn8le17ob01re2aud01"}, "type": "slideshow"}]}]}], "type": "sena", "_data": [{"type": "metadata", "contents": [{"content": "Silly Superstitions", "type": "lesson_name"}, {"content": "Thirteen at the Table", "type": "unit_name"}, {"content": 1, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 17, "type": "lesson"}, {"content": "B1.3", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "  Describe or unusual events through a wider range of B1 language in both work and social contexts.", "type": "primary"}, {"content": " Understands important and specific information and aspects  in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_1"}, {"content": " Understands important and specific information and aspects  in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_2"}, {"content": " Understands important and specific information and aspects  in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_3"}, {"content": " Understands important and specific information and aspects  in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_4"}, {"content": " Understands important and specific information and aspects  in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_5"}, {"content": " Understands important and specific information and aspects  in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_6"}, {"content": " Understands important and specific information and aspects  in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_7"}, {"content": " Understands important and specific information and aspects  in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_8"}]}, {"content": "engenn8le17ob01re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": " Gerunds and Infinitives", "type": "heading"}, {"content": "A <span class=\"strong\">gerund</span> is a verb ending with -ing (doing).<br/> An <span class=\"strong\">infinitive</span> is to + verb (to do).<br/><br/> There are rules about which verbs you can use with gerunds and which verbs  you can use with infinitives. Also, the gerund can be used as the  subject of the sentence.", "type": "describer"}, {"content": "Verbs commonly followed by a gerund:<br/><br/>  Verbs that express <span class=\"strong\">likes</span>/<span class=\"strong\">dislikes</span>:<br/>  <span class=\"italic\">like<br/> love<br/> enjoy<br/> hate</span>", "type": "text"}, {"content": "Example:   <br/><span class=\"italic\">I <span class=\"strong\">loved writing</span> about superstitions.</span>", "type": "text"}, {"content": "<ul><li><span class=\"italic\">like</span>/<span class=\"italic\">love</span>/<span class=\"italic\">hate</span> can also be followed by an infinitive.</li></ul>", "type": "text"}, {"content": "These are some verbs that are followed by an infinitive:<br/>  <span class=\"italic\"> hope<br/> seem<br/> decide<br/> start</span>", "type": "text"}, {"content": "  Example:<br/>  <span class=\"italic\">It took several weeks before I <span class=\"strong\">decided to write</span> about superstitions.</span>", "type": "text"}, {"content": "You use infinitives after adjectives.<br/>  Example:<br/> <span class=\"italic\">I was <span class=\"strong\">scared to write</span> about superstitions last week.</span>", "type": "text"}, {"content": "An activity can be expressed as a gerund and functions as the subject of the sentence. ", "type": "text"}, {"content": " Examples:<br/> <span class=\"italic\"><span class=\"strong\">Dancing</span> is fun.<br/> <span class=\"strong\">Computing</span> saves a lot of time.<br/> <span class=\"strong\">Studying</span> online is very convenient.</span>", "type": "text"}]}, {"type": "learning_points", "contents": [{"content": " Conditional Sentences with <span class=\"italic\">if</span> Clause", "type": "heading"}, {"content": "You use the first conditional with <span class=\"italic\">if</span> clauses to exchange opinions about possible future outcomes.<br/><br/> You use the second conditional to exchange opinions about unreal or imaginary (hypothetical) situations in the future.", "type": "describer"}, {"content": "You use the first conditional to say it's possible that you will or will not do something. In that condition, something else may, may not will or will not happen.", "type": "text"}, {"content": "The parts of the sentence are divided into two clauses:  the <span class=\"italic\">if</span> clause and the  <span class=\"italic\">condition</span> clause.", "type": "text"}, {"content": "You use the second conditional to talk about hypothetical situations. There is no certainty that it's possible to fulfill the condition. ", "type": "text"}, {"content": "  For example: <br/> <span class=\"italic\">If I had a million dollars, I would buy a car.</span>", "type": "text"}, {"content": "   Do you have a million dollars?  No.<br/> Is it possible to suddenly get a million dollars? Not really.<br/> What would you do if you had a million dollars? Buy a car.", "type": "text"}, {"content": " You use the <span class=\"strong\">Simple Past verb</span> + <span class=\"strong\"><span class=\"italic\">would</span></span>", "type": "text"}, {"content": "{\"rows\":2,\"columns\":3,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" First Conditional: 1st Clause\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" First Conditional: 2nd Clause\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Meaning\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">If I finish my work today,</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" <span class=\\\"italic\\\">I'll go to the party tonight.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" It's possible that I can go to the party tonight, but only if I finish my work first. \\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}", "type": "table"}, {"content": "{\"rows\":2,\"columns\":3,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Second Conditional:<br/>If ... + Simple Past\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Second Conditional: <br/>would + base verb\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Result\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" <span class=\\\"italic\\\"> If Loki knocked on my door,</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" <span class=\\\"italic\\\"> I would not answer it.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" It is an impossible situation and can only happen in a hypothetical situation.\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}, {"content": "If I were a more talented writer, I would go into more detail about this topic.", "type": "example"}, {"content": "If Loki knocked on my door, I wouldn't answer.", "type": "example"}, {"content": "If Judas came to my party, I would make him eat outside", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "ancient", "type": "name"}, {"content": "very old", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: There are two ancient events in which a 13th guest attends a dinner celebration. ", "type": "example"}, {"content": "engenn8le17ob01aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": " These are words you use to talk about superstitions.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "superstition", "type": "name"}, {"content": "unreasonable belief in something ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Researching superstitions is something I love to do. ", "type": "example"}, {"content": "engenn8le17ob01aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "crashing a party", "type": "name"}, {"content": "going to a party without being invited ", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: Loki is believed to have introduced  evil into the world after crashing a party.", "type": "example"}, {"content": "engenn8le17ob01aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "mischief", "type": "name"}, {"content": "playful misbehavior or troublemaking ", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: Loki, the God of mischief, introduced evil into the world.", "type": "example"}, {"content": "engenn8le17ob01aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to betray", "type": "name"}, {"content": "to be unfaithful or disloyal ", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Judas, the 13th apostle to arrive at the last supper, later betrayed Jesus. ", "type": "example"}, {"content": "engenn8le17ob01aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "Norse", "type": "name"}, {"content": "pertaining to ancient Scandinavia and its culture", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: The mighty Thor is a character from Norse mythology.  ", "type": "example"}, {"content": "engenn8le17ob01aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "mythology", "type": "name"}, {"content": "stories, traditions or beliefs from a particular culture", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Loki is another character from Norse mythology.", "type": "example"}, {"content": "engenn8le17ob01aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "instance", "type": "name"}, {"content": "a stage of a proceeding ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The next instance of the 13th guest causing trouble comes to us from Norse mythology.    ", "type": "example"}, {"content": "engenn8le17ob01aud08", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to risk", "type": "name"}, {"content": "to take a dangerous chance", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Guests who arrive late at my dinner party risk being turned away.", "type": "example"}, {"content": "engenn8le17ob01aud09", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "Write a story about what happened the night Loki came to dinner as the 13th guest. ", "type": "text"}, {"content": "Make your story 8 to 10 sentences long. ", "type": "text"}, {"content": "What did Loki say? What did he do? How did he bring evil into the world?", "type": "text"}, {"content": "Talk about this hypothetical situation and use gerunds and infinitives to tell your story.", "type": "text"}, {"content": "Read your classmates stories.", "type": "text"}, {"content": "Give each other feedback on your stories.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I talk about my attitudes toward an action. ", "type": "text"}, {"content": "I talk about hypothetical situations.", "type": "text"}, {"content": "I review other people's work and give feedback.", "type": "text"}]}]}