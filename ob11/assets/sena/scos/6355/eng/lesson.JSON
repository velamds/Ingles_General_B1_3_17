tent": "will", "type": "text"}]}, {"type": "post_question", "contents": {"content": "worry about curses if they were real, but they are not.", "type": ""}}, {"content": "secondary_8", "type": "objective"}], "id": 1}, {"responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "would", "type": "text"}], "selected": 0, "correct": 1}], "_data": [{"type": "question", "contents": [{"content": "If ghosts were real, I ", "type": "text"}]}, {"type": "incorrect", "contents": [{"content": "were", "type": "text"}]}, {"type": "post_question", "contents": {"content": "be able to visit the so-called haunted houses. ", "type": ""}}, {"content": "secondary_8", "type": "objective"}], "id": 2}], "_data": [{"type": "instructions", "contents": [{"content": " \nAre ghosts real?\n", "type": "text"}]}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "post_instructions", "contents": [{"content": "Instructions: \n<span class=\"bullet\">Proofread the sentence.</span> \n<span class=\"bullet\">Click on the incorrect word.</span> \n<span class=\"bullet\">Type in the correct word to complete the sentence.\n</span> <span class=\"bullet\">Use capital letters where necessary.</span> ", "type": "text"}]}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}]}], "id": 9, "stimuli_ids": []}, {"template_override": 1, "type": "RSLT", "questions": [{"responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 1}], "_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}], "id": 0}], "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}], "id": 10, "stimuli_ids": []}, {"template_override": 1, "type": "DWS", "questions": [{"responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 1}], "_data": [{"type": "question", "contents": [{"content": "engenn8le17ob11re7pdf01.pdf", "type": "pdf"}]}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": " \nIs that superstition true?\n", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "post_instructions", "contents": [{"content": "\nInstructions: Complete the following steps. Fill in the Self-Assessment.\n", "type": "text"}]}, {"type": "learning_skills", "contents": [{"content": "Speaking", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Reading", "type": "skill"}]}], "id": 11, "stimuli_ids": []}], "stimuli": [{"template_override": 1, "_data": [], "type": "welcome", "contents": [{}], "id": 0}, {"template_override": 1, "_data": [], "type": "audio", "title": "", "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn8le17ob11re2aud01", "coverimg": "engenn8le17ob11re2img05.jpg", "images": [{"image": "engenn8le17ob11re2img05.jpg", "text": "", "id": 0, "time": "0"}, {"image": "engenn8le17ob11re2img05.jpg", "text": "Halloween has arrived. If I were a child again, I would freak out!\nI would be putting on my elegant costume if I were a little girl getting ready to go out. It is so much fun!\nWriting about superstitions was also fun because superstitions are magical and sometimes sacred and I love the stories. I was delighted by your e-mails. I wanted to make my blog entries as entertaining as possible.", "id": 1, "time": "100"}, {"image": "engenn8le17ob11re2img01.jpg", "text": "I hope to hear from all my fans again for the next mailbag bunch. All of your superstition e-mails were read, but if I didn't address yours, I am sorry. Providing me topics makes you all a big part of my blog.  Again I'm sure mistakes were made, so please send me your corrections.<br/><br/>\nWhat am I doing tonight?  I am supposed to give out candy. Then I am supposed to go to a costume party. I was supposed to go to a friend's house for dinner, but I decided not to go. Late tonight, I am supposed to go dancing. So it will be an exciting evening.", "id": 2, "time": "26500"}, {"image": "engenn8le17ob11re2img02.jpg", "text": "Finally, I wanted to talk about one more thing.<br/>\nA lot of you wrote about superstitions and the curse of bad luck and asked me if it is possible to change your luck.<br/>\nMy advice, if I were you I wouldn't worry about being lucky. Don't be a victim.\nInstead, if I were you, I would try to make my own luck by continuing to work hard.\n<br/><br/>\nHappy Halloween.", "id": 3, "time": "59000"}]}}], "id": 1}], "type": "scholar", "id": 0, "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}]}], "_data": [{"type": "metadata", "contents": [{"content": "Silly Superstitions", "type": "lesson_name"}, {"content": "The Truth About Luck", "type": "unit_name"}, {"content": 11, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 17, "type": "lesson"}, {"content": "B1.3", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Describe complicated or unusual events in the past through a wider range of B1 language in both work and social contexts.", "type": "primary"}, {"content": " Understands important and specific information and aspects  in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_1"}, {"content": " Understands important and specific information and aspects  in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_2"}, {"content": " Understands important and specific information and aspects  in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_3"}, {"content": " Understands important and specific information and aspects  in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_4"}, {"content": " Understands important and specific information and aspects  in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_5"}, {"content": " Understands important and specific information and aspects  in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_6"}, {"content": " Understands important and specific information and aspects  in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_7"}, {"content": " Understands important and specific information and aspects  in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_8"}]}, {"content": "engenn8le17ob11re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": " Be Supposed To", "type": "heading"}, {"content": "You use the structure <span class=\"strong\">be supposed to</span> when you want to talk about expectations, obligations or arrangements.", "type": "describer"}, {"content": "You can use <span class=\"strong\">be supposed to</span> to talk about situations in the past, present or future.", "type": "text"}, {"content": "The structure is:", "type": "text"}, {"content": "subject + to be + supposed to + verb", "type": "text"}, {"content": "  <span class=\"italic\">You <span class=\"strong\">are not supposed to</span> come to dinner tonight.<br/> I <span class=\"strong\">am supposed to</span> give out Halloween candy.</span>", "type": "text"}, {"content": "**Pronunciation tip**: When you say be supposed to, you link the /d/ and /t/ sounds together. ", "type": "text"}, {"content": "Like this:<br/>Be suppose_to", "type": "text"}, {"content": "I am supposed to give out candy. Then I am supposed to go to a costume party. ", "type": "example"}, {"content": "I was supposed to go to a friend's house for dinner. ", "type": "example"}, {"content": "Later tonight, I am supposed to go dancing. <br/> <br/>", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": "Conditional Sentences with <span class=\"italic\">If</span> Clause", "type": "heading"}, {"content": "You use the first conditional with <span class=\"italic\">if</span> clauses to exchange opinions about possible future outcomes.<br/> You use the second conditional to exchange opinions about unreal or imaginary (hypothetical) situations in the future.", "type": "describer"}, {"content": "You use the first conditional to say it's possible that you will or will not do something. In that condition, something else may, may not, will, or will not happen.", "type": "text"}, {"content": "The parts of the sentence are divided into two clauses: the <span class=\"italic\">if</span> clause and the <span class=\"italic\">condition</span> clause.<span class=\"prelo-letter-page-break\"></span>", "type": "text"}, {"content": "You use the second conditional to talk about hypothetical situations. There is no certainty that it's possible to fulfill the condition. ", "type": "text"}, {"content": "For example:  <br/><span class=\"italic\">If I  had a million dollars, I would buy a car.</span>", "type": "text"}, {"content": "Do you have a million dollars?  No.<br/> Is it possible to suddenly get a million dollars? Not really.<br/> What would you do if you had a million dollars? Buy a car.", "type": "text"}, {"content": "You use the <span class=\"strong\">Simple Past verb</span> + <span class=\"strong\"><span class=\"italic\">would</span></span>", "type": "text"}, {"content": "{\"rows\":2,\"columns\":3,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"First \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"First Conditional: 2nd Clause\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Meaning\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"  <span class=\\\"italic\\\">If I study today, </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" <span class=\\\"italic\\\">I'll go to the party tonight.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" It's possible that I can go to the party tonight, but only if I study first. \\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}, {"content": "If I were a child again, I would freak out!", "type": "example"}, {"content": "I would be putting on my elegant costume if I were a little girl.", "type": "example"}, {"content": "If I were a child at Halloween again, I would be a princess.", "type": "example"}, {"content": " ", "type": "text"}, {"content": "{\"rows\":2,\"columns\":3,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Second Conditional:<br/>If ... + Simple Past\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Second Conditional: would + base verb\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Result\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" <span class=\\\"italic\\\"> If I were a child again,</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" <span class=\\\"italic\\\"> I would be a princess for Halloween.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" It is an impossible situation because you are not a child  and thus, this can only happen in a hypothetical situation.\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}]}, {"type": "target_word", "contents": [{"content": "to freak out", "type": "name"}, {"content": " to be in a heightened emotional state such as fear or excitement", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: If I were a child again, I would freak out!", "type": "example"}, {"content": "engenn8le17ob11aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": " These are the words to review.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "elegant ", "type": "name"}, {"content": "tasteful or refined", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: I would be putting on my elegant costume if I were a little girl getting ready to go out.", "type": "example"}, {"content": "engenn8le17ob11aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "sacred ", "type": "name"}, {"content": "dedicated or in relation to a deity", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: Superstitions are magical and sometimes sacred. ", "type": "example"}, {"content": "engenn8le17ob11aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "fan", "type": "name"}, {"content": "someone that is devoted to or admires something", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I hope to hear from all my fans again for the next mailbag bunch.", "type": "example"}, {"content": "engenn8le17ob11aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "bunch ", "type": "name"}, {"content": " a group of things that are related to each other and gathered in the same place.", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I hope to hear from all my fans again for the next mailbag bunch.", "type": "example"}, {"content": "engenn8le17ob11aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to address ", "type": "name"}, {"content": "to direct the attention towards something specific", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: All of your superstition e-mails were read, but if I didn't address yours, I am sorry.", "type": "example"}, {"content": "engenn8le17ob11aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "curse", "type": "name"}, {"content": "a source or cause of evil", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: A lot of you wrote about superstitions and the curse of bad luck. ", "type": "example"}, {"content": "engenn8le17ob11aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "victim ", "type": "name"}, {"content": "someone that gets harmed or killed by someone else", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: If I were you I wouldn't worry about being lucky. Don't be a victim. ", "type": "example"}, {"content": "engenn8le17ob11aud08", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "Share a few unusual superstitions with the class.", "type": "text"}, {"content": "Ask them if they think these superstitions are true or untrue. ", "type": "text"}, {"content": "Make sure you encourage your classmates to share the reasons behind their responses. ", "type": "text"}, {"content": "Reveal that a few of your superstitions are false.", "type": "text"}, {"content": "With a partner identify and describe four superstitions. Each superstition can be true or false.", "type": "text"}, {"content": "Separate from your partner and join another group.", "type": "text"}, {"content": "In your group have each person read a superstition and the group members guess if it's true or false and explain why.", "type": "text"}, {"content": "Continue to the next person in the group.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I talk about superstitions. ", "type": "text"}, {"content": "I talk about things I am/was supposed to do and things that are/were supposed to happen.", "type": "text"}, {"content": "I present information clearly and confidently.", "type": "text"}, {"content": "I listen for the gist and details of what is said.", "type": "text"}]}]}