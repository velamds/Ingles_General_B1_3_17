oup_name"}]}, {"content": {"correct_feedback": "Correct!", "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": []}], "type": "RSLT", "template_override": 1}, {"id": 11, "stimuli_ids": [], "questions": [{"_data": [{"type": "question", "contents": [{"content": "engenn8le17ob03re7pdf01.pdf", "type": "pdf"}]}], "responses": [{"id": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "correct": 1}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": " \nDo a student lottery survey.\n", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Speaking", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Reading", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "\nInstructions: Complete the following steps. Fill in the Self-Assessment.\n", "type": "text"}]}], "type": "DWS", "template_override": 1}], "stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "template_override": 1, "id": 0}, {"id": 1, "title": "", "contents": [{"value": {"images": [{"text": "", "id": 0, "time": "0", "image": "engenn8le17ob03re2img05.jpg"}, {"text": "Our reader mailbag:<br/><br/>Brad from Chicago writes, \" I am not a superstitious person, but my friends are. They have several good luck charms; rabbits' feet, horseshoes, lucky numbers, but I think good luck charms are ridiculous. I was wondering if you believe in good luck charms?\"", "id": 1, "time": "100", "image": "engenn8le17ob03re2img05.jpg"}, {"text": "Reading this letter reminds me that I am a very lucky person.  A couple of years ago, I worked in a comic book store part-time because I really wanted to travel and I\nneeded to make some money. Traveling to Europe was my fantasy and I always said if I won the lottery, I would travel there first. If I were lucky enough, it would be the first thing that I would do. But I thought my dream would never come true.", "id": 2, "time": "19000", "image": "engenn8le17ob03re2img01.jpg"}, {"text": "One day,  I was walking down the street and I saw a penny on the ground. I decided to pick it up because I needed the money.  I then went to work and started complaining to my friend Peter about how I didn't have any money. Peter smiled and listened and when I was done, presented me with a lottery ticket he had bought. The next day, I discovered that I had won a million dollars.\n<br/>\nSome people associate my win with that lucky penny, but I associate it all with Peter. Peter is my lucky penny. So Brad, if I were you, I would not make fun of your friends' superstitions, because one day your luck could change.", "id": 3, "time": "44000", "image": "engenn8le17ob03re2img02.jpg"}], "audiosrc": "engenn8le17ob03re2aud01", "coverimg": "engenn8le17ob03re2img05.jpg"}, "type": "slideshow"}], "_data": [], "type": "audio", "template_override": 1}]}]}